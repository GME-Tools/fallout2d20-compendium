        }
      },
      "system": {
        "description": "<p><span class=\"fontstyle0\">If the Assaultron has both its arms or legs injured, or it has been reduced to half or fewer of its maximum HP, it will move towards the nearest enemy and use its major action to self-destruct. This self-destruct is an attack centered upon itself and destroys the Assaultron&nbsp;after it attempts this attack.</span></p>",
        "favorite": false
      },
