        "cost": "0",
        "quantity": 1,
        "rarity": 0,
        "stashed": false,
        "effect": "<p><span class=\"fontstyle0\">Scavengers can salvage from a destroyed Sentry bot with a successful </span><span class=\"fontstyle2\"><strong>INT +</strong><br /><strong>Science</strong> </span><span class=\"fontstyle0\">test with a difficulty of 1. This yields 1 fusion core, 2 CD</span><span class=\"fontstyle3\" style=\"color: #fde635;\">&nbsp;</span><span class=\"fontstyle0\">units of common materials with +1 CD</span><span class=\"fontstyle3\" style=\"color: #fde635;\">&nbsp;</span><span class=\"fontstyle0\">per AP spent, and each Effect yields 1 uncommon material.</span></p>"
      },
