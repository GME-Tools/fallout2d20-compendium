    {
      "_id": "n8xob7LUoV9KQ040",
      "name": "Se lâcher",
      "type": "special_ability",
      "img": "systems/fallout/assets/ico/thumb-up.webp",
      "effects": [],
      "folder": null,
      "sort": 332813,
      "flags": {
        "core": {
          "sourceId": "Item.bXl361asqDDzZnLf"
        }
      },
      "system": {
        "description": "<p>Une fois par combat, le Protectron ajoute la Cadence 4 de ses Lasers de bras aux dégâts d’une attaque, soit 7 DC, et peut employer Rafale sans dépenser de munitions. Si un Laser de bras est blessé, cette attaque n’inflige plus que 5 DC.</p>",
        "favorite": false
      },
      "ownership": {
        "default": 0,
        "I8FU1gA0rIKN7NHn": 3
