    {
      "_id": "oYhLl1MG1EnX340A",
      "name": "Autodestruction",
      "type": "special_ability",
      "img": "systems/fallout/assets/ico/thumb-up.webp",
      "effects": [],
      "folder": null,
      "sort": 334375,
      "flags": {
        "core": {
          "sourceId": "Item.bXl361asqDDzZnLf"
        }
      },
      "system": {
        "description": "<p>Si ses deux bras sont blessés, ou si sa Santé est réduite à la moitié ou moins de son maximum, le Protectron se dirige vers l’ennemi le plus proche et consacre son action majeure à s’autodétruire. Cette attaque est centrée sur lui et le détruit après sa résolution.</p>",
        "favorite": false
      },
