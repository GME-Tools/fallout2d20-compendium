      "_id": "rOVpf9Y8wfYaD2vy",
      "name": "Mousquet laser",
      "type": "weapon",
      "img": "modules/fallout2d20-compendium/artwork/Weapons/Laser%20Musket.webp",
      "effects": [],
      "folder": null,
