{
  "name": "fallout2d20-compendium",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "audit": "node scripts/audit-content.mjs",
    "audit:weights": "node scripts/audit-french-weights.mjs",
    "artwork:check": "node scripts/normalize-artwork.mjs --check",
    "artwork:inventory": "node scripts/generate-artwork-inventory.mjs",
    "artwork:inventory:check": "node scripts/generate-artwork-inventory.mjs --check",
    "build": "node scripts/generate-manifest.mjs --check && node scripts/build-packs.mjs",
    "clean": "node scripts/clean.mjs",
    "package": "node scripts/package-release.mjs",
    "test": "node --test test/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "ci": "npm run artwork:check && npm run artwork:inventory:check && npm run audit && npm run audit:weights && npm run validate && npm test && npm run build && node scripts/verify-built-packs.mjs && npm run package && node scripts/verify-release-package.mjs"
  },
  "devDependencies": {
    "classic-level": "^3.0.0",
    "sharp": "^0.35.4",
    "yazl": "^3.3.1"
  }
}
